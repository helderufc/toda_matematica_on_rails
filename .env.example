# ─── Banco de dados (PostgreSQL) ──────────────────────────────────────────────
# Usando Docker (compose.yml)? Mantenha host=localhost e use a porta mapeada.
# Porta 5433 evita conflito com um PostgreSQL nativo na 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=senha
# DB_NAME só é usado em produção; dev/test usam nomes fixos no database.yml
DB_NAME=toda_matematica_production

# ─── Redis / Valkey ────────────────────────────────────────────────────────────
# db 0 → Action Cable | db 1 → Solid Cache (definido em config/environments/production.rb)
REDIS_URL=redis://localhost:6379/0

# ─── Upload de arquivos ────────────────────────────────────────────────────────
# Caminho absoluto para armazenar uploads. Deixe em branco para usar storage/uploads/
UPLOAD_DIR=

# ─── Servidor web ──────────────────────────────────────────────────────────────
# Número de workers Puma. Recomendado: 1 por núcleo. Só tem efeito em produção.
WEB_CONCURRENCY=
